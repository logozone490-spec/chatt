<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تطبيق الدردشة المباشرة</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 20px; background-color: #e6eef5; display: flex; justify-content: center; align-items: center; height: 100vh; box-sizing: border-box; }
        #chat-container { width: 100%; max-width: 600px; background: white; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); display: flex; flex-direction: column; height: 85vh; overflow: hidden; }
        
        /* شريط العنوان */
        #header { background: #8ba6d3; color: white; padding: 15px; text-align: center; font-size: 1.2em; border-bottom: 1px solid #ccc; }
        
        /* قسم معرّف الغرفة */
        #room-section { padding: 10px; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; align-items: center; background-color: #f9f9f9; }
        #room-id-display { font-size: 0.9em; color: #555; }
        .action-button { background: #eee; border: 1px solid #ccc; padding: 5px 10px; border-radius: 15px; cursor: pointer; font-size: 0.8em; margin-left: 5px; }
        
        /* منطقة الرسائل */
        #messages { flex: 1; padding: 20px; overflow-y: auto; list-style-type: none; margin: 0; display: flex; flex-direction: column-reverse; }
        #messages li { margin-bottom: 15px; padding: 10px 15px; border-radius: 20px; max-width: 80%; word-break: break-word; position: relative; }
        
        /* رسائل المرسل */
        .my-message { background: #bfe8c7; align-self: flex-end; border-bottom-right-radius: 5px; color: #333; }
        
        /* رسائل الآخرين */
        .other-message { background: #d0e1f7; align-self: flex-start; border-bottom-left-radius: 5px; color: #333; }
        
        /* شريط الإدخال السفلي */
        #form { display: flex; border-top: 1px solid #eee; padding: 10px; background: #fff; align-items: center; }
        #input { flex: 1; border: 1px solid #ccc; padding: 10px; border-radius: 25px; outline: none; margin-left: 10px; }
        .input-icon { color: #888; cursor: pointer; font-size: 1.2em; margin: 0 5px; }
        button { background: #28a745; color: white; border: none; padding: 10px 20px; border-radius: 25px; cursor: pointer; }
        button:hover { background: #218838; }
    </style>
</head>
<body>
    <div id="chat-container">
        <!-- شريط العنوان -->
        <div id="header">
            تطبيق الدردشة المباشرة (تطوير)
        </div>
        
        <!-- قسم معرف الغرفة -->
        <div id="room-section">
            <span id="room-id-display">معرف غرفتك للدردشة عن بُعد: <strong>xyz123</strong></span>
            <div>
                <button class="action-button">نسخ</button>
                <button class="action-button">انضمام لغرفة أخرى</button>
            </div>
        </div>
        
        <!-- منطقة الرسائل -->
        <ul id="messages"></ul>
        
        <!-- شريط الإدخال السفلي -->
        <form id="form" action="">
            <i class="input-icon">&#128578;</i> <!-- أيقونة إيموجي -->
            <i class="input-icon">&#128206;</i> <!-- أيقونة إرفاق ملف -->
            <input id="input" autocomplete="off" placeholder="اكتب رسالتك هنا..." />
            <button>إرسال</button>
        </form>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        const form = document.getElementById('form');
        const input = document.getElementById('input');
        const messages = document.getElementById('messages');

        form.addEventListener('submit', (e) => {
            e.preventDefault();
            if (input.value) {
                // إرسال كائن يحتوي على الرسالة ونوعها (أنها رسالتك)
                socket.emit('chat message', { text: input.value, sender: 'me' });
                input.value = '';
            }
        });

        socket.on('chat message', (data) => {
            const item = document.createElement('li');
            item.textContent = data.text;
            
            // تحديد فئة الرسالة (مرسل أم مستقبل) بناءً على المرسل
            if (data.sender === 'me') {
                item.classList.add('my-message');
            } else {
                item.classList.add('other-message');
            }
            
            messages.prepend(item); // إضافة الرسالة في الأعلى لعكس ترتيب العرض
            messages.scrollTop = messages.scrollHeight;
        });
    </script>
</body>
</html>
